# --- Frontend (Vite, exposed to browser) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Netlify Functions (server only, NEVER prefixed with VITE_) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx

# --- Local dev only (optional) ---
# `npm run dev` runs no Netlify functions. Point this at your deployed site so Vite proxies
# /api/google-token there and Google Calendar works on localhost too.
# DEV_API_ORIGIN=https://your-site.netlify.app
